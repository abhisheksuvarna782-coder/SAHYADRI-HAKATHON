# RouteRecover AI - Environment Configuration
# Copy this file to backend/.env for local development and fill in your values.

# Database
DATABASE_URL=sqlite:///./routerecover.db

# AI Provider (optional - app works without this)
# Supported providers: openai, anthropic, none
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application settings
APP_ENV=development
DEBUG=true
SECRET_KEY=changeme-in-production-use-a-long-random-string

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
